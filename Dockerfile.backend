FROM python:3.12-slim

WORKDIR /app

# System deps for pandas/duckdb wheels build smoothly on slim images
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY data/ ./data/

# vectorstore/ and logs/ are created at runtime; mount as volumes in
# docker-compose so the index and audit trail survive container restarts.
RUN mkdir -p vectorstore logs

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
