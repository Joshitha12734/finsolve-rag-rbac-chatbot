# LLM provider: "groq" (default, free API tier), "anthropic" (paid, Claude
# models), or "ollama" (fully local, no API key, no internet dependency
# once a model is pulled)
LLM_PROVIDER=groq

# Groq — get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — only needed if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# Ollama — only needed if LLM_PROVIDER=ollama. Install from ollama.com,
# run `ollama pull llama3.2` (or any model you prefer), then `ollama serve`
# (usually starts automatically after install). No key required.
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# Optional
BACKEND_URL=http://localhost:8000
